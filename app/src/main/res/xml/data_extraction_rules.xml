<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the phone through cloud backup or device-to-device transfer.
     The databases hold raw bank SMS, the finance ledger and chat history, and the mcp_settings
     DataStore holds API keys and OAuth tokens. Opt-in cloud sync (docs/CLOUD_SYNC_PLAN.md) is
     the only way data travels. allowBackup="false" alone doesn't stop device transfer on 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
