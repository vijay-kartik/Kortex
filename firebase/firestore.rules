rules_version = '2';

// Cloud sync (see docs/CLOUD_SYNC_PLAN.md). Every synced record lives under the
// signed-in user, and nothing outside users/{uid} is readable or writable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
