<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+: the share-intake flow posts a "processing complete" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Bank SMS become finance entries (docs/SMS_AUTO_PLAN.md). Asked for from Settings ›
         FINANCES; only SMS from bank-style senders are kept, and only while that's on. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Settings › Add earlier SMS: bank SMS already on the phone, from a chosen day. Asked for only
         when earlier SMS are wanted. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- All-files access: the on-device EmbeddingGemma model (and its tokenizer) are
         read from the public Downloads folder, which scoped storage otherwise blocks.
         Granted via system Settings (Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 11+ package visibility: lets SpeechRecognizer find the device's
         speech-recognition service for on-device voice input. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".KortexApp"
        android:label="Kortex"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Kortex"
        android:supportsRtl="true">

        <!-- configChanges: the UI is all Compose, which re-lays itself out on rotation, so the
             activity isn't rebuilt for it. That keeps a playing topic video (a WebView) going
             when the phone turns to full screen (docs/TOPIC_VIDEOS_PLAN.md, phase 5). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kortex.Starting"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-press launcher shortcuts: "Save to links" and "Ask agent". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Shared text: a valid http(s) link opens the new-link screen pre-filled;
                 anything else is drafted into a new chat (MainActivity.acceptShare). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="kortex"
                    android:host="oauth"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Share intake: photos and PDFs shared from other apps open a floating
             composer over the host app; the agent then runs in the background. -->
        <activity
            android:name=".ShareToKortexActivity"
            android:exported="true"
            android:theme="@style/Theme.Kortex.Share"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Received SMS → BankSms (docs/SMS_AUTO_PLAN.md, phase 4). BROADCAST_SMS: only the
             system can send it, so nothing else can feed the inbox. -->
        <receiver
            android:name=".BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Undo on a bank SMS entry's notification (phase 5). Not exported: only this app's
             notifications reach it. -->
        <receiver
            android:name=".BankSmsActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.kortex.finance.action.UNDO_SMS_ENTRY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
